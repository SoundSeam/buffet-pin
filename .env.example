# App
# Optional in local development. Required in production.
APP_URL=http://localhost:3000
ADMIN_EMAILS=owner@example.com,staff@example.com

# Required in production.
CRON_SECRET=replace-with-a-random-32-plus-character-secret
DRIVER_SESSION_SECRET=replace-with-a-different-random-32-plus-character-secret

# Neon Postgres + Prisma
# Use the pooled connection for runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@EP-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Use the direct connection for Prisma migrations and CLI commands.
DIRECT_URL="postgresql://USER:PASSWORD@EP-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Delivery address validation and autocomplete
# Requires Google Maps Geocoding API, Places API, and Places API legacy endpoints.
GEOCODING_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# Clover payments
# Buffet Pin Direct requires iframe mapped-order checkout. Hosted Checkout cannot
# safely preserve the mapped Clover order/payment/print identity and is fail-closed
# for delivery intake.
CLOVER_CHECKOUT_MODE=iframe
CLOVER_ENV=sandbox
CLOVER_MERCHANT_ID=
# Public browser-safe Clover iframe key. Required only when CLOVER_CHECKOUT_MODE=iframe.
CLOVER_PUBLIC_ACCESS_KEY=
# Legacy shared server token fallback for local/sandbox compatibility. Prefer the
# two purpose-specific tokens below and leave this blank in production.
CLOVER_PRIVATE_TOKEN=
# Server-only Clover Platform token with the approved Orders/Inventory/Print grants.
CLOVER_PLATFORM_TOKEN=
# Server-only Clover Ecommerce token used only for charges/refunds.
CLOVER_ECOMMERCE_PRIVATE_TOKEN=
CLOVER_WEBHOOK_SECRET=
# Exact secret expected in the X-Clover-Auth header for Platform webhooks.
CLOVER_PLATFORM_WEBHOOK_AUTH=
# Optional Clover API override for local tunneling/testing. Leave blank for normal sandbox/production.
CLOVER_API_BASE_URL=
# Local sandbox-only workaround for premade USD Clover test merchants.
# Not allowed in production. Leave blank for real Canadian/CAD merchant credentials.
CLOVER_TEST_CHARGE_CURRENCY=

# Local/sandbox only. Bypasses ordering availability and delivery-zone validation.
# Leave unset or false for production.
ORDERING_TEST_BYPASS=false

# Provider fakes and failure injection are local/test-only and are rejected in production.
# Keep real/false unless intentionally running the documented fake-flow harness.
PROVIDER_MODE=real
FAILURE_INJECTION_ENABLED=false

# Durable AWS async control plane. `inline` preserves local development behavior;
# `shadow` records jobs without dispatch; `aws` dispatches through SQS/Scheduler.
ASYNC_JOBS_MODE=inline
AWS_REGION=us-east-2
AWS_ASYNC_ROLE_ARN=
AWS_CRITICAL_QUEUE_URL=
AWS_CRITICAL_QUEUE_ARN=
AWS_NOTIFICATION_QUEUE_URL=
AWS_NOTIFICATION_QUEUE_ARN=
AWS_SCHEDULER_GROUP_NAME=buffet-pin-production
AWS_SCHEDULER_ROLE_ARN=
AWS_SCHEDULER_DLQ_ARN=
# Generated during infrastructure deployment. Server-only and distinct from other secrets.
ASYNC_CALLBACK_SECRET=

# Realtime invalidations. AppSync messages never contain customer/order details.
NEXT_PUBLIC_REALTIME_MODE=poll
NEXT_PUBLIC_APPSYNC_EVENTS_HTTP_URL=
NEXT_PUBLIC_APPSYNC_EVENTS_REALTIME_URL=
REALTIME_SIGNING_SECRET=

# Twilio SMS
# Set all three values to enable SMS. Leave all three blank to disable SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Customer order email. Keep disabled until the sender/domain is approved.
# Fake provider mode records deterministic successful email delivery in tests.
ORDER_EMAIL_PROVIDER=disabled
RESEND_API_KEY=
ORDER_EMAIL_FROM="Buffet PIN <orders@example.com>"
