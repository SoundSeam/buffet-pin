generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ReservationLanguage {
  EN
  FR
}

enum OrderServiceType {
  PICKUP
  DELIVERY
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderRefundStatus {
  NOT_REQUIRED
  REQUIRED
  PENDING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum OrderFulfillmentStatus {
  DRAFT
  AWAITING_PAYMENT
  AWAITING_ACCEPTANCE
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  DRIVER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  ARRIVING_SOON
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentProvider {
  CLOVER
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SUBMITTING
  SENT
  DELIVERED
  FAILED
  UNKNOWN
  SKIPPED
}

enum OrderActorType {
  CUSTOMER
  ADMIN
  DRIVER
  SYSTEM
  WEBHOOK
}

enum DriverAssignmentStatus {
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  ARRIVING_SOON
  DELIVERED
  CANCELLED
}

enum PrintJobPurpose {
  INITIAL
  REPRINT
  FALLBACK
}

enum PrintJobStatus {
  PENDING
  SUBMITTING
  SUBMITTED
  PRINTING
  PRINTED
  FAILED
  UNKNOWN
  CANCELLED
}

enum OrderProductionStatus {
  AWAITING_ACCEPTANCE
  ACCEPTED
  PREPARING
  PACKING
  PACKED
  AT_DISPATCH_DESK
  REJECTED
  CANCELLED
}

enum OrderDispatchStatus {
  UNASSIGNED
  RUN_PLANNED
  READY_FOR_PICKUP
  PICKED_UP
  EN_ROUTE
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum StaffRole {
  MANAGER
  OPERATOR
  DISPATCHER
  REPORTING
  TECHNICAL
}

enum CatalogOwnership {
  APP_OWNED
  CLOVER_OWNED
}

enum CatalogEntityType {
  CATEGORY
  ITEM
  MODIFIER_GROUP
  MODIFIER_OPTION
  TAX_RATE
  ORDER_TYPE
  SERVICE_CHARGE
}

enum CatalogMappingStatus {
  VERIFIED
  STALE
  MISSING
  DISABLED
  AMBIGUOUS
}

enum RefundIntentStatus {
  PENDING
  SUBMITTING
  UNKNOWN
  SUCCEEDED
  FAILED
  REQUIRES_REVIEW
}

enum OperationalAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OperationalAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum DeliveryRunStatus {
  DRAFT
  APPROVED
  ASSIGNED
  READY
  PICKED_UP
  EN_ROUTE
  COMPLETED
  CANCELLED
  EXCEPTION
}

enum DeliveryStopStatus {
  PLANNED
  BAG_VERIFIED
  PICKED_UP
  EN_ROUTE
  ARRIVED
  DELIVERED
  FAILED
  RETURNED_TO_DESK
  CANCELLED
}

enum DeliveryProofStatus {
  STORED
  FAILED
  REPLACED
}

enum AsyncJobLane {
  CRITICAL
  NOTIFICATION
}

enum AsyncJobState {
  PENDING
  DISPATCHING
  DISPATCHED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Reservation {
  id                    String              @id @default(cuid())
  confirmationCode      String              @unique
  manageToken           String              @unique
  status                ReservationStatus   @default(PENDING)
  reservationDate       DateTime            @db.Date
  reservationTime       DateTime            @db.Time(0)
  reservationAt         DateTime
  partySize             Int
  guestName             String
  guestPhone            String
  guestEmail            String?
  language              ReservationLanguage @default(FR)
  specialRequests       String?
  internalNotes         String?
  confirmationSentAt    DateTime?
  reminderLastAttemptAt DateTime?
  reminderMessageSid    String?             @unique
  reminderStatus        String?
  reminderSentAt        DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([reservationDate, reservationTime])
  @@index([status])
}

model Settings {
  onlineReservationsEnabled Boolean               @default(false)
  id                        Int                   @id @default(1)
  slotCapacityGuests        Int                   @default(24)
  minPartySize              Int
  maxPartySize              Int
  firstSlot                 DateTime              @db.Time(0)
  lastSlot                  DateTime              @db.Time(0)
  slotIntervalMinutes       Int
  guestModifyCutoffHours    Int
  slotCapacities            SlotCapacitySetting[]
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
}

model SlotCapacitySetting {
  id              String   @id @default(cuid())
  settingsId      Int      @default(1)
  settings        Settings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  reservationTime DateTime @db.Time(0)
  capacityGuests  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([settingsId, reservationTime])
  @@index([settingsId])
}

model ClosureDate {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicApiRateLimit {
  scope           String
  identifierHash  String
  hitCount        Int      @default(1)
  windowStartedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([scope, identifierHash])
  @@index([expiresAt])
}

model MenuCategory {
  id                String     @id @default(cuid())
  name              String
  description       String?
  sortOrder         Int        @default(0)
  isActive          Boolean    @default(true)
  isDeliveryChannel Boolean    @default(true)
  items             MenuItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model MenuItem {
  id                String                  @id @default(cuid())
  categoryId        String
  category          MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name              String
  description       String?
  priceCents        Int
  imageUrl          String?
  sortOrder         Int                     @default(0)
  isAvailable       Boolean                 @default(true)
  isActive          Boolean                 @default(true)
  isDeliveryChannel Boolean                 @default(true)
  modifierGroups    MenuItemModifierGroup[]
  orderItems        OrderItem[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([categoryId, sortOrder])
  @@index([isAvailable, isActive])
}

model CatalogConfiguration {
  id                            Int              @id @default(1)
  ownership                     CatalogOwnership @default(APP_OWNED)
  provider                      String           @default("clover")
  requiredTaxMappingKey         String           @default("quebec-combined")
  requiredGstTaxMappingKey      String           @default("quebec-gst")
  requiredQstTaxMappingKey      String           @default("quebec-qst")
  requiredOrderTypeKey          String           @default("delivery")
  requiredDeliveryFeeMappingKey String           @default("delivery-fee")
  maxMappingAgeMinutes          Int              @default(1440)
  lastSyncStartedAt             DateTime?
  lastSyncCompletedAt           DateTime?
  lastSyncError                 String?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
}

model ProviderCatalogMapping {
  id                  String               @id @default(cuid())
  provider            String               @default("clover")
  entityType          CatalogEntityType
  localKey            String
  providerId          String
  status              CatalogMappingStatus @default(MISSING)
  localFingerprint    String
  providerFingerprint String?
  providerUpdatedAt   DateTime?
  verifiedAt          DateTime?
  issueCode           String?
  issueMessage        String?
  providerSnapshot    Json?
  semanticExpectation Json?
  semanticApprovedBy  String?
  semanticApprovedAt  DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([provider, entityType, localKey])
  @@unique([provider, entityType, providerId])
  @@index([provider, status, entityType])
}

model ModifierGroup {
  id            String                  @id @default(cuid())
  name          String
  description   String?
  minSelections Int                     @default(0)
  maxSelections Int                     @default(1)
  isRequired    Boolean                 @default(false)
  sortOrder     Int                     @default(0)
  isActive      Boolean                 @default(true)
  options       ModifierOption[]
  menuItems     MenuItemModifierGroup[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([isActive, sortOrder])
}

model ModifierOption {
  id              String              @id @default(cuid())
  modifierGroupId String
  modifierGroup   ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  name            String
  priceDeltaCents Int                 @default(0)
  sortOrder       Int                 @default(0)
  isAvailable     Boolean             @default(true)
  isActive        Boolean             @default(true)
  orderModifiers  OrderItemModifier[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([modifierGroupId, sortOrder])
  @@index([isAvailable, isActive])
}

model MenuItemModifierGroup {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId, sortOrder])
}

model Customer {
  id        String              @id @default(cuid())
  name      String
  phone     String
  email     String?
  language  ReservationLanguage @default(FR)
  addresses CustomerAddress[]
  orders    Order[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([phone])
  @@index([email])
}

model CustomerAddress {
  id                   String   @id @default(cuid())
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label                String?
  addressLine1         String
  addressLine2         String?
  city                 String
  province             String
  postalCode           String
  country              String   @default("CA")
  latitude             Float?
  longitude            Float?
  deliveryInstructions String?
  orders               Order[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([customerId])
  @@index([postalCode])
}

model Order {
  id                          String                 @id @default(cuid())
  publicCode                  String                 @unique
  legacyPublicTrackingEnabled Boolean                @default(false)
  trackingToken               String                 @unique @default(dbgenerated("(gen_random_uuid())::text"))
  orderNumber                 String                 @unique @default(dbgenerated("('BP-'::text || upper(substr(md5((gen_random_uuid())::text), 1, 10)))"))
  serviceType                 OrderServiceType
  paymentStatus               OrderPaymentStatus     @default(PENDING)
  refundStatus                OrderRefundStatus      @default(NOT_REQUIRED)
  fulfillmentStatus           OrderFulfillmentStatus @default(DRAFT)
  productionStatus            OrderProductionStatus  @default(AWAITING_ACCEPTANCE)
  dispatchStatus              OrderDispatchStatus    @default(UNASSIGNED)
  customerId                  String
  customer                    Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerAddressId           String?
  customerAddress             CustomerAddress?       @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)
  customerName                String
  customerPhone               String
  customerEmail               String?
  deliveryAddressLine1        String?
  deliveryAddressLine2        String?
  deliveryCity                String?
  deliveryProvince            String?
  deliveryPostalCode          String?
  deliveryCountry             String?
  deliveryLatitude            Float?
  deliveryLongitude           Float?
  deliveryDistanceKm          Float?
  deliveryZoneIdSnapshot      String?
  deliveryZoneNameSnapshot    String?
  deliveryInstructions        String?
  isAsap                      Boolean                @default(true)
  requestedFor                DateTime?
  estimatedReadyStartAt       DateTime?
  estimatedReadyEndAt         DateTime?
  estimatedDeliveryStartAt    DateTime?
  estimatedDeliveryEndAt      DateTime?
  promisedDeliveryStartAt     DateTime?
  promisedDeliveryEndAt       DateTime?
  dispatchDeadlineAt          DateTime?
  acceptanceDeadlineAt        DateTime?
  acceptanceDecisionAt        DateTime?
  acceptanceTimedOutAt        DateTime?
  itemsSubtotalCents          Int
  taxableSubtotalCents        Int
  gstCents                    Int                    @default(0)
  qstCents                    Int                    @default(0)
  taxCents                    Int
  tipCents                    Int                    @default(0)
  deliveryFeeCents            Int                    @default(0)
  discountCents               Int                    @default(0)
  totalCents                  Int
  currency                    String                 @default("CAD")
  customerNotes               String?
  internalNotes               String?
  rejectionReason             String?
  acceptedAt                  DateTime?
  preparationStartedAt        DateTime?
  preparationExtendedMinutes  Int                    @default(0)
  readyForDeliveryAt          DateTime?
  packingStartedAt            DateTime?
  packedAt                    DateTime?
  atDispatchDeskAt            DateTime?
  rejectedAt                  DateTime?
  cancelledAt                 DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  items                       OrderItem[]
  payments                    Payment[]
  events                      OrderEvent[]
  notifications               Notification[]
  driverAssignment            DriverAssignment?
  externalOrders              ExternalOrder[]
  printJobs                   PrintJob[]
  deliveryStops               DeliveryStop[]
  packingChecks               PackingCheck[]
  refundIntents               RefundIntent[]
  machineTestGrant            MachineTestGrant?

  @@index([paymentStatus, refundStatus, fulfillmentStatus, serviceType, createdAt])
  @@index([customerId])
  @@index([customerAddressId])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([trackingToken])
  @@index([productionStatus, dispatchStatus, createdAt])
  @@index([productionStatus, acceptanceDeadlineAt])
}

model MachineTestGrant {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  createdByStaffId String
  createdByLabel   String?
  expiresAt        DateTime
  consumedAt       DateTime?
  revokedAt        DateTime?
  orderId          String?   @unique
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())

  @@index([expiresAt, consumedAt, revokedAt])
  @@index([createdByStaffId, createdAt])
}

model OrderNumberSequence {
  serviceDate DateTime @id @db.Date
  nextValue   Int      @default(1)
  updatedAt   DateTime @updatedAt
}

model ExternalOrder {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            PaymentProvider
  providerOrderId     String?
  state               String
  requestKey          String          @unique
  submissionToken     String?
  submissionStartedAt DateTime?
  sanitizedData       Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([provider, providerOrderId])
  @@unique([orderId, provider])
  @@index([state, updatedAt])
  @@index([submissionStartedAt])
}

model PrintJob {
  id                   String          @id @default(cuid())
  orderId              String
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  initialForOrderId    String?         @unique
  purpose              PrintJobPurpose
  status               PrintJobStatus  @default(PENDING)
  idempotencyKey       String          @unique
  providerPrintEventId String?         @unique
  attempts             Int             @default(0)
  reason               String?
  requestedByActorType OrderActorType
  requestedByActorId   String?
  requestedByLabel     String?
  sanitizedRequest     Json?
  sanitizedObservation Json?
  lastErrorCode        String?
  lastErrorMessage     String?
  submittedAt          DateTime?
  observedAt           DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([orderId, createdAt])
}

model PackingCheck {
  id                       String    @id @default(cuid())
  orderId                  String
  order                    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId              String
  orderItem                OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  expectedQuantity         Int
  verifiedQuantity         Int
  instructionsAcknowledged Boolean
  actorId                  String
  actorLabel               String?
  verifiedAt               DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([orderId, orderItemId])
  @@index([orderId, verifiedAt])
}

model OrderItem {
  id                          String              @id @default(cuid())
  orderId                     String
  order                       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId                  String?
  menuItem                    MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuItemNameSnapshot        String
  menuItemDescriptionSnapshot String?
  quantity                    Int
  unitPriceCents              Int
  modifiersTotalCents         Int                 @default(0)
  lineSubtotalCents           Int
  specialInstructions         String?
  sortOrder                   Int                 @default(0)
  modifiers                   OrderItemModifier[]
  packingChecks               PackingCheck[]
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  @@index([orderId])
  @@index([menuItemId])
}

model OrderItemModifier {
  id                         String          @id @default(cuid())
  orderItemId                String
  orderItem                  OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierGroupId            String?
  modifierOptionId           String?
  modifierOption             ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)
  modifierGroupNameSnapshot  String
  modifierOptionNameSnapshot String
  priceDeltaCents            Int             @default(0)
  quantity                   Int             @default(1)
  createdAt                  DateTime        @default(now())

  @@index([orderItemId])
  @@index([modifierOptionId])
}

model Payment {
  id                         String                @id @default(cuid())
  orderId                    String
  order                      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider                   PaymentProvider
  status                     OrderPaymentStatus    @default(PENDING)
  refundStatus               OrderRefundStatus     @default(NOT_REQUIRED)
  amountCents                Int
  refundedAmountCents        Int                   @default(0)
  currency                   String                @default("CAD")
  checkoutSessionId          String?               @unique
  providerIdempotencyKey     String?               @unique
  checkoutRequestFingerprint String?
  providerPaymentId          String?               @unique
  providerOrderId            String?
  hostedCheckoutUrl          String?
  sessionExpiresAt           DateTime?
  paidAt                     DateTime?
  failedAt                   DateTime?
  refundRequestedAt          DateTime?
  refundedAt                 DateTime?
  failureCode                String?
  failureMessage             String?
  rawProviderData            Json?
  webhookEvents              PaymentWebhookEvent[]
  refundIntents              RefundIntent[]
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  @@index([orderId])
  @@index([provider, status])
  @@index([refundStatus])
}

model RefundIntent {
  id                     String             @id @default(cuid())
  requestKey             String             @unique
  orderId                String
  order                  Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId              String
  payment                Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  status                 RefundIntentStatus @default(PENDING)
  amountCents            Int
  currency               String             @default("CAD")
  reason                 String
  actorId                String
  actorLabel             String?
  providerRefundId       String?            @unique
  providerIdempotencyKey String             @unique
  attemptCount           Int                @default(0)
  lastErrorCode          String?
  lastErrorMessage       String?
  requestPayload         Json?
  providerResponse       Json?
  submittedAt            DateTime?
  lastAttemptAt          DateTime?
  resolvedAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([orderId, status])
  @@index([paymentId, status])
  @@index([status, updatedAt])
}

model OperationalAlert {
  id             String                   @id @default(cuid())
  alertKey       String                   @unique
  category       String
  severity       OperationalAlertSeverity
  status         OperationalAlertStatus   @default(OPEN)
  entityType     String?
  entityId       String?
  orderNumber    String?
  summary        String
  details        Json?
  firstSeenAt    DateTime                 @default(now())
  lastSeenAt     DateTime                 @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, severity, lastSeenAt])
  @@index([category, status])
  @@index([entityType, entityId])
}

model OperationalAuditEvent {
  id         String         @id @default(cuid())
  actorType  OrderActorType
  actorId    String?
  actorLabel String?
  eventType  String
  entityType String
  entityId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([eventType, createdAt])
}

model ReconciliationImport {
  id               String                   @id @default(cuid())
  serviceDate      String
  timezone         String
  source           String
  importedBy       String
  importedByLabel  String?
  providerRowCount Int
  providerRows     Json
  report           Json
  variances        ReconciliationVariance[]
  createdAt        DateTime                 @default(now())

  @@index([serviceDate, createdAt])
}

model ReconciliationVariance {
  id                String                 @id @default(cuid())
  importId          String
  import            ReconciliationImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  varianceKey       String
  alertKey          String
  status            OperationalAlertStatus @default(OPEN)
  providerPaymentId String?
  orderId           String?
  orderNumber       String?
  reasons           Json
  localSnapshot     Json?
  providerSnapshot  Json?
  acknowledgedAt    DateTime?
  acknowledgedBy    String?
  resolvedAt        DateTime?
  resolvedBy        String?
  resolutionNote    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([importId, varianceKey])
  @@index([status, createdAt])
  @@index([providerPaymentId])
}

model PaymentWebhookEvent {
  id                  String          @id @default(cuid())
  provider            PaymentProvider
  providerEventId     String
  eventType           String
  checkoutSessionId   String?
  providerPaymentId   String?
  paymentId           String?
  payment             Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payload             Json
  processingStartedAt DateTime?
  processingToken     String?
  processedAt         DateTime?
  createdAt           DateTime        @default(now())

  @@unique([provider, providerEventId])
  @@index([checkoutSessionId])
  @@index([providerPaymentId])
  @@index([paymentId])
  @@index([processingStartedAt])
  @@index([processingToken])
}

model OrderEvent {
  id                    String                  @id @default(cuid())
  requestKey            String?                 @unique
  orderId               String
  order                 Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorType             OrderActorType
  actorId               String?
  actorLabel            String?
  eventType             String
  fromPaymentStatus     OrderPaymentStatus?
  toPaymentStatus       OrderPaymentStatus?
  fromFulfillmentStatus OrderFulfillmentStatus?
  toFulfillmentStatus   OrderFulfillmentStatus?
  fromProductionStatus  OrderProductionStatus?
  toProductionStatus    OrderProductionStatus?
  fromDispatchStatus    OrderDispatchStatus?
  toDispatchStatus      OrderDispatchStatus?
  message               String?
  metadata              Json?
  createdAt             DateTime                @default(now())

  @@index([orderId, createdAt])
  @@index([eventType])
}

model Notification {
  id                String              @id @default(cuid())
  orderId           String?
  order             Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId        String?
  recipient         String
  channel           NotificationChannel
  templateKey       String
  idempotencyKey    String              @unique
  body              String
  status            NotificationStatus  @default(PENDING)
  provider          String?
  providerMessageId String?             @unique
  attemptCount      Int                 @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([recipient])
}

model AsyncJob {
  id                 String        @id @default(cuid())
  kind               String
  lane               AsyncJobLane
  aggregateType      String
  aggregateId        String
  payloadVersion     Int           @default(1)
  payload            Json?
  dedupeKey          String        @unique
  runAt              DateTime      @default(now())
  state              AsyncJobState @default(PENDING)
  dispatchAttempts   Int           @default(0)
  processingAttempts Int           @default(0)
  queueMessageId     String?
  scheduleName       String?       @unique
  leaseToken         String?
  leaseExpiresAt     DateTime?
  dispatchedAt       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  lastErrorCode      String?
  lastErrorMessage   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([state, runAt])
  @@index([lane, state, runAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([leaseExpiresAt])
}

model DeliveryZone {
  id                         String                  @id @default(cuid())
  configurationKey           String?                 @unique
  name                       String
  isActive                   Boolean                 @default(true)
  centerLatitude             Float
  centerLongitude            Float
  radiusKm                   Float
  boundaryGeoJson            Json?
  displayColor               String?
  description                String?
  targetDriveMinutes         Int?
  deliveryFeeCents           Int                     @default(0)
  minimumOrderCents          Int                     @default(0)
  freeDeliveryThresholdCents Int?
  sortOrder                  Int                     @default(0)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  driverEligibilities        DriverZoneEligibility[]

  @@index([isActive, sortOrder])
}

model Driver {
  id                String                  @id @default(cuid())
  email             String?                 @unique
  name              String
  phone             String?
  isActive          Boolean                 @default(true)
  sessionVersion    Int                     @default(0)
  assignments       DriverAssignment[]
  accessTokens      DriverAccessToken[]
  deliveryRuns      DeliveryRun[]
  deliveryProofs    DeliveryProof[]
  zoneEligibilities DriverZoneEligibility[]
  shifts            DriverShift[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([isActive])
}

model DriverShift {
  id        String   @id @default(cuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId, isActive, startsAt, endsAt])
}

model DriverZoneEligibility {
  id             String       @id @default(cuid())
  driverId       String
  driver         Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  deliveryZoneId String
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([driverId, deliveryZoneId])
  @@index([deliveryZoneId, isActive])
}

model StaffMember {
  id           String             @id @default(cuid())
  email        String             @unique
  displayName  String
  authUserId   String?            @unique
  role         StaffRole
  isActive     Boolean            @default(true)
  revokedAt    DateTime?
  accessEvents StaffAccessEvent[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([role, isActive])
}

model StaffAccessEvent {
  id            String         @id @default(cuid())
  staffMemberId String
  staffMember   StaffMember    @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  eventType     String
  actorType     OrderActorType
  actorId       String?
  actorLabel    String?
  fromRole      StaffRole?
  toRole        StaffRole?
  reason        String?
  metadata      Json?
  createdAt     DateTime       @default(now())

  @@index([staffMemberId, createdAt])
}

model DeliveryRun {
  id                       String            @id @default(cuid())
  runNumber                String            @unique
  requestKey               String            @unique
  status                   DeliveryRunStatus @default(DRAFT)
  zoneIdSnapshot           String
  zoneNameSnapshot         String
  capacity                 Int               @default(4)
  driverId                 String?
  driver                   Driver?           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  approvedByActorId        String?
  approvedByActorLabel     String?
  crossZoneOverride        Boolean           @default(false)
  overrideReason           String?
  routeExplanation         String?
  routingStatus            String?
  estimatedDurationSeconds Int?
  estimatedDistanceMeters  Int?
  plannedDepartureAt       DateTime?
  approvedAt               DateTime?
  handedOffAt              DateTime?
  handedOffByActorId       String?
  handedOffByActorLabel    String?
  dispatchedAt             DateTime?
  pickedUpAt               DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  stops                    DeliveryStop[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([driverId, status])
}

model DeliveryStop {
  id               String             @id @default(cuid())
  runId            String
  run              DeliveryRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  position         Int
  status           DeliveryStopStatus @default(PLANNED)
  etaAt            DateTime?
  bagVerifiedAt    DateTime?
  bagVerifiedBy    String?
  pickedUpAt       DateTime?
  arrivedAt        DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  returnedToDeskAt DateTime?
  cancelledAt      DateTime?
  exceptionCode    String?
  exceptionNote    String?
  proof            DeliveryProof?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([runId, position])
  @@unique([runId, orderId])
  @@index([orderId, status])
}

model DeliveryProof {
  id             String              @id @default(cuid())
  stopId         String              @unique
  stop           DeliveryStop        @relation(fields: [stopId], references: [id], onDelete: Restrict)
  driverId       String
  driver         Driver              @relation(fields: [driverId], references: [id], onDelete: Restrict)
  status         DeliveryProofStatus @default(STORED)
  mimeType       String
  byteSize       Int
  checksumSha256 String
  imageBytes     Bytes
  capturedAt     DateTime
  storedAt       DateTime            @default(now())
  replacedAt     DateTime?
  failureCode    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([driverId, createdAt])
  @@index([status, storedAt])
}

model DriverAccessToken {
  id         String    @id @default(cuid())
  driverId   String
  driver     Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?

  @@index([driverId, revokedAt])
}

model DriverAssignment {
  id          String                 @id @default(cuid())
  orderId     String                 @unique
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId    String
  driver      Driver                 @relation(fields: [driverId], references: [id], onDelete: Restrict)
  status      DriverAssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime               @default(now())
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([driverId, status])
}

model RestaurantOrderSettings {
  id                             Int       @id @default(1)
  onlineOrderingEnabled          Boolean   @default(false)
  pickupEnabled                  Boolean   @default(false)
  deliveryEnabled                Boolean   @default(false)
  scheduledOrdersEnabled         Boolean   @default(false)
  asapOnly                       Boolean   @default(true)
  restaurantLatitude             Float?
  restaurantLongitude            Float?
  deliveryRadiusKm               Float     @default(8)
  deliveryFeeCents               Int       @default(0)
  minimumDeliveryOrderCents      Int       @default(0)
  freeDeliveryThresholdCents     Int?
  defaultPickupPrepMinutes       Int       @default(25)
  defaultDeliveryPrepMinutes     Int       @default(45)
  busyModeEnabled                Boolean   @default(false)
  busyModeExtraMinutes           Int       @default(0)
  maxActiveOrders                Int?
  dispatchMaxWaitMinutes         Int       @default(10)
  dispatchDeadlineBufferMinutes  Int       @default(20)
  dispatchLowDemandReleaseCount  Int       @default(2)
  orderCutoffMinutesBeforeClose  Int?
  gstRatePpm                     Int       @default(50000)
  qstRatePpm                     Int       @default(99750)
  orderAdminSmsRecipient         String?
  acceptanceWindowMinutes        Int       @default(12)
  missedAcceptancePauseThreshold Int       @default(2)
  missedAcceptanceCount          Int       @default(0)
  intakePausedAt                 DateTime?
  intakePauseReason              String?
  intakePausedBy                 String?
  proofRetentionDays             Int       @default(30)
  partialRefundsEnabled          Boolean   @default(false)
  receiptLegalName               String?
  receiptAddress                 String?
  receiptPhone                   String?
  receiptTaxRegistration         String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
}

model DrinkCategory {
  id        String      @id @default(cuid())
  nameEn    String
  nameFr    String
  sortOrder Int         @default(0)
  items     DrinkItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([sortOrder, nameEn])
}

model DrinkItem {
  id            String        @id @default(cuid())
  categoryId    String
  category      DrinkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameEn        String
  nameFr        String
  descriptionEn String?
  descriptionFr String?
  imageUrl      String?
  priceCents    Int?
  isVisible     Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([categoryId, sortOrder, nameEn])
}

// Append-only evidence for administrator changes to online booking availability.
model ReservationAvailabilityEvent {
  id              String   @id @default(cuid())
  previousEnabled Boolean
  enabled         Boolean
  actorId         String
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// Append-only menu mutation history, independent of reservation and order domains.
model DrinkMenuEvent {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entityId, createdAt])
}
