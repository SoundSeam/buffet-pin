{
  "name": "buffet-pin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <23 || >=24"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-map-worker.mjs --prisma",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:db": "node scripts/test-database.mjs",
    "security:audit": "node scripts/security-audit.mjs --production",
    "build:safe": "node scripts/build-safe.mjs",
    "verify": "node scripts/verify.mjs",
    "launch:preflight:sandbox": "node scripts/launch-preflight.mjs --target=sandbox",
    "launch:preflight:production": "node scripts/launch-preflight.mjs --target=production",
    "launch:preflight:production:probe": "node scripts/launch-preflight.mjs --target=production --probe",
    "qr:drinks": "node scripts/generate-drinks-qr.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "prisma:seed": "prisma db seed",
    "staff:provision-manager": "node scripts/provision-manager.mjs",
    "infra:synth": "cdk synth",
    "infra:diff": "cdk diff",
    "infra:deploy": "cdk deploy --require-approval never",
    "test:reservations": "vitest run tests/reservation-switch.test.ts tests/reservation-party-size.test.ts",
    "test:reservations:db": "vitest run tests/reservation-switch.database.test.ts tests/reservation-party-size.database.test.ts --no-file-parallelism",
    "test:reservations:browser": "playwright test --config playwright.reservations.config.ts",
    "security:audit:full": "node scripts/security-audit.mjs --full",
    "predev": "node scripts/build-map-worker.mjs",
    "pretest:browser": "node scripts/build-map-worker.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "$sharp",
    "@prisma/config@6.19.3": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-scheduler": "3.1108.0",
    "@aws-sdk/client-secrets-manager": "3.1108.0",
    "@aws-sdk/client-sqs": "3.1108.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "6.19.3",
    "@smithy/protocol-http": "5.6.0",
    "@smithy/signature-v4": "5.7.0",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.105.1",
    "@vercel/oidc-aws-credentials-provider": "3.3.4",
    "framer-motion": "11.18.2",
    "lucide-react": "0.469.0",
    "maplibre-gl": "6.14.0",
    "next": "15.5.27",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.6.0",
    "twilio": "6.0.0",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "aws-cdk": "2.1136.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "jsqr": "1.4.0",
    "postcss": "8.5.23",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@tailwindcss/postcss": "4.3.3",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-import-resolver-node": "0.3.10",
    "eslint-import-resolver-typescript": "3.10.1",
    "globals": "14.0.0",
    "tinyglobby": "0.2.17",
    "vite": "8.1.5"
  }
}
